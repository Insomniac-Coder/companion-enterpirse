{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "jsx": "react-jsx",
    "strict": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    // Vite bundles; tsc only checks. The .ts ending lets Node's test runner load the same imports.
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src"]
}
