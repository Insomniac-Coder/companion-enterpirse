# Local conversations, databases, attachments, backups, and downloaded models.
/data/
/backend/data/
# Keep the folder in fresh clones, but never track downloaded model/runtime files.
/models/*
!/models/.gitkeep
# The model downloader is project code, not a downloaded artefact.
!/models/modeldownloader.py
/backups/
/backend/backups/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.gguf
*.safetensors

# Build products and installed dependencies (keep lockfiles in Git).
# The llama.cpp runtime is built from runtime/llama.cpp.lock.json; only the lock is tracked.
/build/
/runtime/*
!/runtime/llama.cpp.lock.json
# The private PostgreSQL comes from runtime/postgresql.lock.json (scripts/get-postgres.ps1).
!/runtime/postgresql.lock.json
/backend/target/
node_modules/
/frontend/dist/
coverage/
*.tsbuildinfo
__pycache__/
*.py[cod]
.venv/
venv/

# Machine-local configuration and secrets; safe example files may be committed.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# Runtime logs and generated evaluation traces (may contain local chat/file data).
*.log
/docs/validation/**/*.json

# Editor and OS artifacts.
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo

# A model's tool check depends on this machine's runtime build: never committed.
/models/**/tooling.json
/models/**/tooling.json.tmp

# What scripts/e2e/e2e.mjs writes for each run (the report is read, not kept).
/scripts/e2e/*.txt
/scripts/e2e/generated.py

# Page previews from docs/enterprise/plan-source/render.sh
docs/enterprise/plan-source/preview-*.png
